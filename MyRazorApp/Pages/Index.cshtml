@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<style>
    .selected-column {
        background-color: #0d6efd !important;
        color: white;
    }

    .header-button {
        all: unset;
        font-weight: bold;
        cursor: pointer;
        padding: 4px 6px;
    }
</style>

<div class="container mt-5">
    <div class="row">
        <!-- Form -->
        <div class="col-md-4">
            <h3>@(Model.ClassInfo.Id > 0 ? "Edit Class" : "Add Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="ClassInfo.Id" />
                <div class="mb-3">
                    <label class="form-label">Class Name</label>
                    <input type="text" asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Student Count</label>
                    <input type="number" asp-for="ClassInfo.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" asp-for="ClassInfo.IsActive" />
                    <label class="form-check-label" asp-for="ClassInfo.IsActive">IsActive</label>
                </div>
                <button type="submit" asp-page-handler="Add" class="btn btn-primary">
                    @(Model.ClassInfo.Id > 0 ? "Update Class" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Table -->
        <div class="col-md-8">
            <h3>Class List</h3>

            <!-- Filter input -->
            <form method="get" id="filterForm">
                <input type="text" name="Filter" value="@Model.Filter"
                       class="form-control mb-3" placeholder="Search class name..." id="filterInput" />
                @foreach (var col in Model.SelectedColumns)
                {
                    <input type="hidden" name="SelectedColumns" value="@col" />
                }
            </form>

            <!-- Export Button -->
            <form method="post" asp-page-handler="ExportJson" class="mb-3">
                <input type="hidden" name="Filter" value="@Model.Filter" />
                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                @foreach (var col in Model.SelectedColumns)
                {
                    <input type="hidden" name="SelectedColumns" value="@col" />
                }
                <button type="submit" class="btn btn-success">Export to JSON</button>
            </form>

            <table class="table table-striped mt-3">
                <thead>
                    <tr>
                        @foreach (var col in new[] { "ClassName", "StudentCount", "Description" })
                        {
                            <th class="@(Model.SelectedColumns.Contains(col) ? "selected-column" : "")">
                                <form method="post" asp-page-handler="SelectColumn" style="display:inline">
                                    @foreach (var selected in Model.SelectedColumns)
                                    {
                                        <input type="hidden" name="SelectedColumns" value="@selected" />
                                    }
                                    <input type="hidden" name="column" value="@col" />
                                    <input type="hidden" name="Filter" value="@Model.Filter" />
                                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                    <button type="submit" class="header-button">
                                        @(col == "ClassName" ? "Class Name" :
                                          col == "StudentCount" ? "Student Count" : "Description")
                                    </button>
                                </form>
                            </th>
                        }
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TableData)
                    {
                        <tr>
                            <td class="@(Model.SelectedColumns.Contains("ClassName") ? "selected-column" : "")">@item.ClassName</td>
                            <td class="@(Model.SelectedColumns.Contains("StudentCount") ? "selected-column" : "")">@item.StudentCount</td>
                            <td class="@(Model.SelectedColumns.Contains("Description") ? "selected-column" : "")">@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination with hidden selectedColumns -->
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <form method="get" style="display:inline;">
                                <input type="hidden" name="PageNumber" value="@i" />
                                <input type="hidden" name="Filter" value="@Model.Filter" />
                                @foreach (var col in Model.SelectedColumns ?? new List<string>())
                                {
                                    <input type="hidden" name="SelectedColumns" value="@col" />
                                }
                                <button type="submit" class="page-link">@i</button>
                            </form>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const input = document.getElementById("filterInput");
        let timer;
        input.addEventListener("input", function () {
            clearTimeout(timer);
            timer = setTimeout(() => {
                document.getElementById("filterForm").submit();
            }, 500);
        });
    </script>
}