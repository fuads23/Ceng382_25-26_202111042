@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<div class="container mt-5">
    <div class="row">
        <!-- Form -->
        <div class="col-md-4">
            <h3>@(Model.ClassInfo.Id > 0 ? "Edit Class" : "Add Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="ClassInfo.Id" />
                <div class="mb-3">
                    <label class="form-label">Class Name</label>
                    <input type="text" asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Student Count</label>
                    <input type="number" asp-for="ClassInfo.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                </div>
                <button type="submit" asp-page-handler="Add" class="btn btn-primary">
                    @(Model.ClassInfo.Id > 0 ? "Update Class" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Table -->
        <div class="col-md-8">
            <h3>Class List</h3>

            <form method="get" class="mb-3">
                <input type="text" name="Filter" value="@Model.Filter" placeholder="Filter by Class Name..." class="form-control d-inline w-75" />
                <button type="submit" class="btn btn-secondary mt-2">Filter</button>
            </form>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ClassInformationTableList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-pageNumber="@i" asp-route-filter="@Model.Filter">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>