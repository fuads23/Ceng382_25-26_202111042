@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<div class="container mt-5">
    <div class="row">
        <!-- Form -->
        <div class="col-md-4">
            <h3>@(Model.ClassInfo.Id > 0 ? "Edit Class" : "Add Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="ClassInfo.Id" />
                <div class="mb-3">
                    <label for="ClassName" class="form-label">Class Name</label>
                    <input type="text" asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="StudentCount" class="form-label">Student Count</label>
                    <input type="number" asp-for="ClassInfo.StudentCount" class="form-control" 
                    value="@(Model.ClassInfo.StudentCount == 0 ? "" : Model.ClassInfo.StudentCount.ToString())" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                </div>
                <button type="submit" asp-page-handler="Add" class="btn btn-primary">
                    @(Model.ClassInfo.Id > 0 ? "Update Class" : "Add Class")
                </button>
            </form>
        </div>


        <!-- Table -->
        <div class="col-md-8">
            <h3>Class List</h3>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in MyRazorApp.Pages.IndexModel.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm">Edit</button>
                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>