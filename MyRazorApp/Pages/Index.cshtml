@page
@model MyRazorApp.Pages.IndexModel
@{
    ViewData["Title"] = "Class Management";
}

<div class="container mt-5">
    <div class="row">
        <!-- Form -->
        <div class="col-md-4">
            <h3>@(Model.ClassInfo.Id > 0 ? "Edit Class" : "Add Class")</h3>
            <form method="post">
                <input type="hidden" asp-for="ClassInfo.Id" />
                <div class="mb-3">
                    <label class="form-label">Class Name</label>
                    <input type="text" asp-for="ClassInfo.ClassName" class="form-control" />
                    <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Student Count</label>
                    <input type="number" asp-for="ClassInfo.StudentCount" class="form-control" />
                    <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="ClassInfo.Description" class="form-control"></textarea>
                    <span asp-validation-for="ClassInfo.Description" class="text-danger"></span>
                </div>
                <button type="submit" asp-page-handler="Add" class="btn btn-primary">
                    @(Model.ClassInfo.Id > 0 ? "Update Class" : "Add Class")
                </button>
            </form>
        </div>

        <!-- Table + Filter + Export -->
        <div class="col-md-8">
            <h3>Class List</h3>

            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="Filter" value="@Model.Filter" class="form-control"
                        placeholder="Filter by Class Name..." />
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                </div>
            </form>

            <form method="post" asp-page-handler="ExportJson" class="mb-4">
                <input type="hidden" name="Filter" value="@Model.Filter" />
                <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                
                <div class="mb-2">
                    <strong>Export Type:</strong><br />
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ExportType" value="all" id="exportAll"
                            checked />
                        <label class="form-check-label" for="exportAll">Unfiltered Export</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="ExportType" value="filtered"
                            id="exportFiltered" />
                        <label class="form-check-label" for="exportFiltered">Filtered Export</label>
                    </div>
                </div>

                <div class="mb-3">
                    <strong>Select columns to export:</strong><br />
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="ClassName"
                            id="colClassName" checked />
                        <label class="form-check-label" for="colClassName">Class Name</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="StudentCount"
                            id="colStudentCount" checked />
                        <label class="form-check-label" for="colStudentCount">Student Count</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedColumns" value="Description"
                            id="colDescription" checked />
                        <label class="form-check-label" for="colDescription">Description</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-success">Export to JSON</button>
            </form>

            <table class="table table-striped mt-3">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TableData)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" asp-page-handler="Edit"
                                        class="btn btn-warning btn-sm">Edit</button>
                                    <button type="submit" asp-page-handler="Delete"
                                        class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-route-PageNumber="@i" asp-route-Filter="@Model.Filter">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>
